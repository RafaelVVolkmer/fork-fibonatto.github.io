# Normalize repository text to LF while leaving unknown binary formats alone.
* text=auto eol=lf

# Project text, source, configuration, and documentation formats.
*.allow text eol=lf
*.args text eol=lf
*.c text eol=lf diff=cpp
*.conf text eol=lf
*.h text eol=lf diff=cpp
*.html text eol=lf diff=html
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf diff=markdown
*.mjs text eol=lf
*.mk text eol=lf
*.rego text eol=lf
*.sha256 text eol=lf
*.sh text eol=lf diff=bash
*.svg text eol=lf
*.tag text eol=lf
*.tmpl text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

.brotli-version text eol=lf
.cosign-version text eol=lf
.emscripten-version text eol=lf
.syft-version text eol=lf
.terser-version text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf
.nojekyll text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.dockerignore text eol=lf

