# SPDX-License-Identifier: MIT

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = off

[*.{c,h}]
indent_style = tab
indent_size = 8
tab_width = 8
max_line_length = 80

[{Makefile,**/Makefile,*.mk}]
indent_style = tab
indent_size = 8
tab_width = 8

[*.{sh,rego,conf}]
indent_style = tab
indent_size = 8
tab_width = 8

[{Dockerfile,**/Dockerfile}]
indent_style = tab
indent_size = 8
tab_width = 8

[*.{yaml,yml}]
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = 100

[*.{json,toml,js,mjs}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{css,html,tmpl,svg}]
indent_style = space
indent_size = 4
tab_width = 4

[*.md]
indent_style = space
indent_size = 2
tab_width = 2
trim_trailing_whitespace = false

[*.{allow,args,txt}]
indent_style = space
indent_size = 2
tab_width = 2

[.editorconfig]
indent_style = space
indent_size = 2

# EOF
